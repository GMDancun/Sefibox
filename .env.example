# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Set to False in production
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF, required when serving
# over HTTPS behind a custom domain, e.g. https://krypbox.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Force these True in production (defaults to !DEBUG already)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# PostgreSQL
DB_NAME=krypbox
DB_USER=krypbox
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (verification links). Dev default prints to console; set real
# SMTP creds in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KrypBox <no-reply@yourdomain.com>
